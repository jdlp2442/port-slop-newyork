int _LocalLightCount, _LocalLightSteps, _LocalShadowsEnabled;
int _LocalLightZOffset;
float _LocalLightStrength;
float4 _LocalPositions[8], _LocalColors[8], _LocalDirections[8], _LocalParams[8];
RWTexture3D<float4> _RWLightVolume;
float3 _LightGridRes;

RWTexture2D<float4> _SmokeAlbedo;  // rgb = color acumulado, a = 1 - transmitancia
RWTexture2D<float2> _SmokeMask;    // r = máscara, g = distancia a la primera muestra densa
RWTexture2D<float2> _SmokeSceneShadow; // attenuation and receiver eye depth
int _SceneShadowsEnabled, _SceneShadowCascadeCount, _ReceiveSceneShadows;
float _SmokeCastShadowStrength;

float4x4 _CameraToWorld;
float4x4 _CameraInvProjection;
float4x4 _CameraInvViewProj;
float3 _CameraWorldPos;
float3 _CameraForward;
float2 _BufferSize;                // w,h del target de humo

SamplerState gPointClamp;
SamplerState gLinearClamp;
SamplerState sampler_linear_repeat;
SamplerState sampler_linear_clamp;

int _VolumeCount, _LightingIndex, _VoxelMode;
float4 _VolumeMinVoxel[GUNNELL_MAX_VOLUMES], _VolumeResFade[GUNNELL_MAX_VOLUMES], _VolumeOriginRadius[GUNNELL_MAX_VOLUMES], _VolumeShape[GUNNELL_MAX_VOLUMES];
float4 _VolumeRelease[GUNNELL_MAX_VOLUMES];
float4 _VolumeActiveMin[GUNNELL_MAX_VOLUMES], _VolumeActiveMax[GUNNELL_MAX_VOLUMES];
