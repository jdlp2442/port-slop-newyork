// GunnellSmoke.compute — implementación propia para URP.
//
// Técnica (flood-fill de vóxeles + raymarch por compute con ruido Worley
// enlosable generado en runtime): arquitectura pública del vídeo de Acerola
// ("CS2 smoke grenades"), reescrita desde cero para RenderGraph/URP. No se ha
// copiado código del repositorio de referencia (sin licencia).
//
// Tres kernels:
//   CS_GenerateWorley — rellena el volumen compartido con Worley FBM enlosable.
//   CS_Raymarch       — marcha analítica por píxel contra la rejilla de
//                       ocupación, con iluminación filtrada y fase HG.
//   CS_LightingVolume — autosombra compartida en espacio de mundo.
//
// FALTABAN los `#pragma kernel`. Sin ellos Unity no registra los kernels:
// `ComputeShader.HasKernel("CS_GenerateWorley")` devolvía false, la feature
// avisaba "[Gunnell Smoke] Sin ComputeShader válido: el pase no se encolará" y
// el humo no se dibujaba nunca. El shader parecía correcto porque las funciones
// y sus [numthreads] estaban ahí, pero no había nada que despachar.

#pragma kernel CS_GenerateWorley
#pragma kernel CS_Raymarch
#pragma kernel CS_LightingVolume
#pragma kernel CS_LocalLighting
#pragma kernel CS_SceneShadow

// Use URP's current shadow constants and atlas, including cascade transforms.
#define _ADDITIONAL_LIGHT_SHADOWS
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Shadows.hlsl"

// ---------------------------------------------------------- ruido Worley

RWTexture3D<float2> _RWNoiseTex; // x = blended billows for the silhouette, y = Worley FBM detail

int _NoiseSeed;
int _NoiseCells;      // celdas por eje en la octava base (entero: enlosable)
int _NoiseOctaves;
float _NoiseAmplitude;
float _NoiseWarp;     // deformación de dominio en baldosas
float _NoiseAdd;      // sesgo aditivo
int _NoiseInvert;
int _NoiseResolution;

// Hash determinista 3D -> [0,1). Barato y sin texturas.
float GunnellHash(int3 p, int seed)
{
    uint h = (uint)(p.x * 374761393 + p.y * 668265263 + p.z * 2147483647 + seed * 144665);
    h = (h ^ (h >> 13)) * 1274126177u;
    h = h ^ (h >> 16);
    return (float)h * (1.0 / 4294967295.0);
}

// Worley F1 invertido (1 en el centro de la celda, 0 en bordes) con enlosado
// toroidal: los índices de retícula se envuelven en módulo para que el volumen
// repita sin costuras.
float GunnellWorley(float3 uvw, int cells, int seed)
{
    float3 p = uvw * (float)cells;
    float3 base = floor(p);
    float3 f = frac(p);
    float d = 8.0;
    for (int z = -1; z <= 1; z++)
    for (int y = -1; y <= 1; y++)
    for (int x = -1; x <= 1; x++)
    {
        int3 cell = (int3)(base + float3((float)x, (float)y, (float)z));
        // Módulo positivo sin `%` entero (que en DX12 es lento y avisa). Con
        // floor() la parte negativa también cae dentro de [0, cells).
        int3 wrapped = cell - cells * (int3)floor((float3)cell / (float)cells);
        float3 feature = float3(
            GunnellHash(wrapped + int3(11, 0, 0), seed),
            GunnellHash(wrapped + int3(0, 23, 0), seed),
            GunnellHash(wrapped + int3(0, 0, 37), seed));
        float3 diff = float3(x, y, z) + feature - f;
        d = min(d, dot(diff, diff));
    }
    // Perfil compacto y redondeado de F1: (1 - distancia²)^3.
    // Evita la caída lineal que daba lóbulos con puntas y hombros rígidos.
    float rounded = saturate(1.0 - d);
    return rounded * rounded * rounded;
}

float GunnellValueNoise(float3 uvw, int cells, int seed)
{
    float3 p = uvw * cells;
    int3 cell = (int3)floor(p);
    float3 f = frac(p);
    f = f * f * (3.0 - 2.0 * f);
    float value = 0.0;
    for (int z = 0; z <= 1; z++)
    for (int y = 0; y <= 1; y++)
    for (int x = 0; x <= 1; x++)
    {
        int3 c = cell + int3(x, y, z);
        c -= cells * (int3)floor((float3)c / cells);
        float3 weight = lerp(1.0 - f, f, float3(x, y, z));
        value += GunnellHash(c, seed) * weight.x * weight.y * weight.z;
    }
    return value;
}

// Compact overlapping billows replace the nearest-feature boundary in the
// macro channel. Cubic kernels reach zero with zero slope; a quadratic union
// blends unequal, oblique rolls without separating their crests into beads.
// This work is done only when baking the shared noise texture.
float GunnellBillows(float3 uvw, int cells, int seed)
{
    float3 p = uvw * cells;
    int3 base = (int3)floor(p);
    float3 f = frac(p);
    float sum = 0.0;
    for (int z = -1; z <= 1; z++)
    for (int y = -1; y <= 1; y++)
    for (int x = -1; x <= 1; x++)
    {
        int3 cell = base + int3(x, y, z);
        int3 wrapped = cell - cells * (int3)floor((float3)cell / cells);
        float3 feature = 0.18 + 0.64 * float3(
            GunnellHash(wrapped + int3(11, 0, 0), seed),
            GunnellHash(wrapped + int3(0, 23, 0), seed),
            GunnellHash(wrapped + int3(0, 0, 37), seed));
        float3 delta = float3(x, y, z) + feature - f;
        // Unequal axes and radii produce broad rolls, rather than a collection
        // of equal spherical caps. Keep every support radius below 1.18 cells:
        // the existing 27-cell search then includes all nonzero neighbours.
        float3 variation = (feature - 0.18) / 0.64;
        float3 axes = lerp(0.78, 1.14, variation.zxy);
        float3 rolled = float3(0.8 * delta.x + 0.6 * delta.z, delta.y,
            -0.6 * delta.x + 0.8 * delta.z) / axes;
        float radiusSquared = lerp(0.85, 1.05, GunnellHash(wrapped + int3(7, 13, 19), seed));
        float kernel = saturate(1.0 - dot(rolled, rolled) / radiusSquared);
        float billow = kernel * kernel * kernel;
        // A quadratic union retains the broad crests while connecting saddles.
        // The previous fourth-power union isolated each crest like a bead.
        sum += billow * billow;
    }
    float rounded = sqrt(sum);
    return rounded * rsqrt(1.0 + rounded * rounded);
}

[numthreads(8, 8, 8)]
void CS_GenerateWorley(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint)_NoiseResolution)) return;
    float3 uvw = ((float3)id + 0.5) / (float)_NoiseResolution;

    // Tres campos suaves independientes deforman el dominio al generar la
    // textura compartida; no se recalculan en cada muestra del raymarch.
    float3 warpUVW = uvw;
    if (_NoiseWarp > 0.001)
    {
        int warpCells = max(2, _NoiseCells >> 1);
        float3 warp = float3(
            GunnellValueNoise(uvw, warpCells, _NoiseSeed + 101),
            GunnellValueNoise(uvw, warpCells, _NoiseSeed + 211),
            GunnellValueNoise(uvw, warpCells, _NoiseSeed + 307));
        warpUVW = frac(uvw + (warp - 0.5) * _NoiseWarp * 0.2);
    }

    // Canales separados: la primera octava conserva los lóbulos grandes de la
    // silueta; el FBM completo puede filtrarse por distancia sin redondear la nube.
    int cells = max(2, _NoiseCells);
    float macro = GunnellBillows(warpUVW, cells, _NoiseSeed);
    float sum = 0.0;
    float amp = 1.0;
    float norm = 0.0;
    // El detalle empieza en la segunda octava para no duplicar los lóbulos macro.
    cells *= 2;
    for (int o = 0; o < 8; o++)
    {
        if (o >= max(1, _NoiseOctaves - 1)) break;
        // No generar frecuencias por encima de Nyquist: no añaden detalle
        // resoluble y sólo introducen aliasing y coste al crear el volumen.
        if (cells > (_NoiseResolution >> 1)) break;
        float cellular = GunnellWorley(warpUVW, cells, _NoiseSeed + (o + 1) * 17);

        sum += cellular * amp;
        norm += amp;
        amp *= 0.5;
        cells *= 2;
    }
    float v = sum / max(norm, 1e-4);
    v = saturate(v + _NoiseAdd);
    if (_NoiseInvert != 0) v = 1.0 - v;
    float fbm = saturate(macro + 0.5 * sum + _NoiseAdd) * _NoiseAmplitude;
    float erosion = _NoiseInvert != 0 ? max(0.0, _NoiseAmplitude - fbm) : fbm;
    float roundedMacro = _NoiseInvert != 0 ? 1.0 - macro : macro;
    // La macro mantiene el tamaño de los lóbulos y el FBM esculpe su interior.
    _RWNoiseTex[id] = float2(roundedMacro, lerp(v, erosion / max(_NoiseAmplitude, 0.001), 0.45));
}

// ---------------------------------------------------------- marcha

Texture3D<float2> _NoiseTex;
Texture2D<float> _DepthTex;
// Keep this count in sync with GunnellSmokeFeature.MaxVolumes.
// Unity compute kernels allow 64 textures. 20 * 3 + noise + depth = 62.
#define GUNNELL_MAX_VOLUMES 20
Texture3D<float2> _Occupancy0, _Occupancy1, _Occupancy2, _Occupancy3, _Occupancy4, _Occupancy5, _Occupancy6, _Occupancy7, _Occupancy8, _Occupancy9, _Occupancy10, _Occupancy11, _Occupancy12, _Occupancy13, _Occupancy14, _Occupancy15, _Occupancy16, _Occupancy17, _Occupancy18, _Occupancy19;
