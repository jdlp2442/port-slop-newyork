float4 _VolumeSunLayout[GUNNELL_MAX_VOLUMES], _VolumeLocalLayout[GUNNELL_MAX_VOLUMES];
float4 _VolumeLightingTexel[GUNNELL_MAX_VOLUMES];
// Explicit per-call context. Every density evaluation chooses its own cloud;
// integration order is along the ray, never by camera-to-cloud distance.
#define _GridRes ((int3)_VolumeResFade[volume].xyz)
#define _GridMin (_VolumeMinVoxel[volume].xyz)
#define _VoxelSize (_VolumeMinVoxel[volume].w)
#define _SmokeOrigin (_VolumeOriginRadius[volume].xyz)
#define _SphereRadius (_VolumeOriginRadius[volume].w)
#define _VerticalScale (_VolumeShape[volume].x)
#define _Dissipation (_VolumeShape[volume].y)
#define _WakeActive ((int)_VolumeShape[volume].z)
#define _BlastCount ((int)_VolumeShape[volume].w)
#define _BlastOffset (volume * 2)
#define _Fade (_VolumeResFade[volume].w)
#define _ReleaseAge (_VolumeRelease[volume].x)
#define _ReleaseEnergy (_VolumeRelease[volume].y)
#define _BlastWakeActive ((int)_VolumeRelease[volume].w)

float3 _SunDirection;              // dirección HACIA el sol, normalizada
float3 _SunColor;
float3 _SmokeColor;

int _StepCount;
int _OverlapDetailLimit; // 0 = original detail for every contribution; 2 = crowded view
int _SceneShadowSteps;
Texture2D<float4> _ViewSmokeAlbedo;
float _InteriorDetail;
float _StepSize;
int _LightStepCount;
float _LightStepSize;
float _VolumeDensity;
float _Absorption;
float _Scattering;
float _ShadowDensity;
float _PhaseG;                     // anisotropía HG (el ref usa 0 + Rayleigh)
int _PhaseFunc;                    // 0 = HG, 2 = Rayleigh (default del ref)
float _NoiseErode;                 // cuánto erosiona el ruido (0 = nube lisa)
float _AnimationStrength;
float3 _AnimationDirection;
float _TurbulenceStrength;
float _TurbulenceScale;
float _TurbulenceSpeed;
float _TimeSeconds;
float _AlphaThreshold;
float _DensityFalloff;             // = 1 - densityFalloff (ref); umbral del smoothstep
float _ShapeDeformation;            // deformación macro de la superficie en espacio normalizado
float _NoiseWorldScale;
float _DetailStrength;
float _LobeContrast;
